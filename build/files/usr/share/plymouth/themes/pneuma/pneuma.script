// Pneuma Breath — Plymouth boot theme
// A luminous core breathing in the dark: expanding breath-waves and rising vapor
// Pneuma (πνεῦμα) — breath, spirit, the animating principle
//
// Palette: deep blue-black background, warm-white core, teal-cyan waves and motes
// The core awakens first, then breath-waves ripple outward on each exhale

// ── Background: deep blue-black ─────────────────────────────────────────────
Window.SetBackgroundTopColor(0.02, 0.04, 0.06);
Window.SetBackgroundBottomColor(0.03, 0.06, 0.09);

center_x = Window.GetX() + Window.GetWidth() / 2;
center_y = Window.GetY() + Window.GetHeight() / 2;
mote_span = Math.Int(Window.GetHeight() / 2) + 80;
PI = 3.14159;
DOT_W = 6; // approximate half-width of a glyph for centering

// ── Title ───────────────────────────────────────────────────────────────────
title = Image.Text("P N E U M A", 0.55, 0.80, 0.85, 1, "Sans 14");
title_sprite = Sprite(title);
title_sprite.SetX(center_x - title.GetWidth() / 2);
title_sprite.SetY(center_y + 240);
title_sprite.SetOpacity(0.0);

// ── The Core ────────────────────────────────────────────────────────────────
// A bright center of breath with a soft halo ring that swells and settles
core_img = Image.Text("●", 0.95, 0.98, 0.95);
core_sprite = Sprite(core_img);
core_sprite.SetOpacity(0.0);

NUM_HALO = 6;
HALO_RADIUS = 18;
halo = [];
for (i = 0; i < NUM_HALO; i++) {
    img = Image.Text("●", 0.60, 0.90, 0.92);
    halo[i] = Sprite(img);
    halo[i].SetOpacity(0.0);
}

// ── Breath Waves ────────────────────────────────────────────────────────────
// Four wave-fronts of dots that ripple outward from the core and dissolve,
// staggered so a new wave leaves on each quarter of the breath period
NUM_WAVES = 4;
WAVE_N = 24;
WAVE_MAX_R = 230;
WAVE_PERIOD = 448; // frames for a full journey; /4 stagger between fronts

waves = [];
for (w = 0; w < NUM_WAVES; w++) {
    for (i = 0; i < WAVE_N; i++) {
        // inner fronts brighter cyan, outer fade toward deep teal (set per-frame)
        img = Image.Text("●", 0.35, 0.75, 0.80);
        waves[w * WAVE_N + i] = Sprite(img);
        waves[w * WAVE_N + i].SetOpacity(0.0);
    }
}

// ── Vapor Motes ─────────────────────────────────────────────────────────────
// Faint breath-vapor drifting upward with a slow sway, wrapping at the top
NUM_MOTES = 13;
motes = [];
for (i = 0; i < NUM_MOTES; i++) {
    img = Image.Text("●", 0.45, 0.65, 0.70);
    motes[i] = Sprite(img);
    motes[i].SetOpacity(0.0);
}

// ── Animation ───────────────────────────────────────────────────────────────
progress = 0;

fun refresh_callback() {
    progress++;

    // ── Awakening sequence ──────────────────────────────────────────────
    // Core fades in first, waves begin rippling, vapor rises, title last

    core_fade = progress / 90;
    if (core_fade > 1) core_fade = 1;

    wave_fade = (progress - 120) / 60;
    if (wave_fade < 0) wave_fade = 0;
    if (wave_fade > 1) wave_fade = 1;

    mote_fade = (progress - 150) / 60;
    if (mote_fade < 0) mote_fade = 0;
    if (mote_fade > 1) mote_fade = 1;

    title_fade = (progress - 180) / 60;
    if (title_fade < 0) title_fade = 0;
    if (title_fade > 1) title_fade = 1;
    title_sprite.SetOpacity(0.85 * title_fade);

    // ── Breath cycle ────────────────────────────────────────────────────
    // ~9 s period; squaring the rising half gives a quicker inhale,
    // longer exhale — the rhythm of a body at rest
    s = Math.Sin(progress * 0.014);
    breath = (s + 1) / 2;
    if (s > 0) breath = breath * breath;

    // ── Core ────────────────────────────────────────────────────────────
    core_pulse = 0.55 + 0.45 * breath;
    core_sprite.SetX(center_x - DOT_W);
    core_sprite.SetY(center_y - DOT_W);
    core_sprite.SetOpacity(core_pulse * core_fade);

    // ── Halo — swells with the inhale ───────────────────────────────────
    halo_r = HALO_RADIUS * (0.7 + 0.6 * breath);
    for (i = 0; i < NUM_HALO; i++) {
        angle = (progress * 0.02) + (i * 2 * PI / NUM_HALO);
        x = center_x + Math.Int(halo_r * Math.Cos(angle)) - DOT_W;
        y = center_y + Math.Int(halo_r * Math.Sin(angle)) - DOT_W;
        halo[i].SetX(x);
        halo[i].SetY(y);
        halo[i].SetOpacity((0.35 + 0.55 * breath) * core_fade);
    }

    // ── Breath waves — ripple outward and dissolve ──────────────────────
    for (w = 0; w < NUM_WAVES; w++) {
        // each front staggered by a quarter period
        t = progress + w * WAVE_PERIOD / NUM_WAVES;
        frac = (t % WAVE_PERIOD) / WAVE_PERIOD;
        r = HALO_RADIUS + (WAVE_MAX_R - HALO_RADIUS) * frac;
        strength = 1 - frac; // fade as the wave travels outward

        for (i = 0; i < WAVE_N; i++) {
            angle = (i * 2 * PI / WAVE_N) + w * 0.3;
            x = center_x + Math.Int(r * Math.Cos(angle)) - DOT_W;
            y = center_y + Math.Int(r * Math.Sin(angle)) - DOT_W;
            idx = w * WAVE_N + i;
            waves[idx].SetX(x);
            waves[idx].SetY(y);

            shimmer = (Math.Sin(progress * 0.03 + i * 0.6) + 1) / 2;
            waves[idx].SetOpacity((0.10 + 0.45 * strength) * (0.6 + 0.4 * shimmer) * wave_fade);
        }
    }

    // ── Vapor motes — rise and sway, wrap at the top ────────────────────
    for (i = 0; i < NUM_MOTES; i++) {
        speed = 0.35 + 0.35 * ((i * 7) % 5) / 5;
        rise = Math.Int(progress * speed + i * 61) % mote_span;
        x = center_x + Math.Int((30 + (i * 37) % 170) * Math.Cos(i * 2.4))
            + Math.Int(14 * Math.Sin(progress * 0.01 + i * 1.7)) - DOT_W;
        y = center_y - rise - DOT_W;
        motes[i].SetX(x);
        motes[i].SetY(y);

        // fade in near the core, out near the top of the ascent
        life = rise / mote_span;
        mote_op = 4 * life * (1 - life) * 0.35;
        motes[i].SetOpacity(mote_op * mote_fade);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// ── Password prompt ─────────────────────────────────────────────────────────
fun display_password_callback(prompt, bullets) {
    pw_label = Image.Text(prompt, 0.55, 0.80, 0.85, 1, "Sans 12");
    pw_sprite = Sprite(pw_label);
    pw_sprite.SetX(center_x - pw_label.GetWidth() / 2);
    pw_sprite.SetY(center_y + 270);

    bullet_str = "";
    for (i = 0; i < bullets; i++)
        bullet_str += "● ";
    pw_dots = Image.Text(bullet_str, 0.60, 0.90, 0.92, 1, "Sans 14");
    pw_dot_sprite = Sprite(pw_dots);
    pw_dot_sprite.SetX(center_x - pw_dots.GetWidth() / 2);
    pw_dot_sprite.SetY(center_y + 300);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

// ── System messages ─────────────────────────────────────────────────────────
fun message_callback(text) {
    msg = Image.Text(text, 0.55, 0.80, 0.85, 1, "Sans 10");
    msg_sprite = Sprite(msg);
    msg_sprite.SetX(center_x - msg.GetWidth() / 2);
    msg_sprite.SetY(center_y + 340);
}

Plymouth.SetMessageFunction(message_callback);
