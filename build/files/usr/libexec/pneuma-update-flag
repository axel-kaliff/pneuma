#!/usr/bin/bash
# Maintain /run/pneuma/update-staged — the signal the Omarchy bar's update
# badge reads (via the overridden omarchy-update-available). Runs after
# the base's uupd auto-update stages a bootc deployment; /run clears on
# reboot, which is exactly when the badge should clear.
set -euo pipefail

mkdir -p /run/pneuma

if bootc status --format json 2> /dev/null | jq -e '.status.staged != null' > /dev/null; then
    touch /run/pneuma/update-staged
else
    rm -f /run/pneuma/update-staged
fi
