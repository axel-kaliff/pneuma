[Unit]
Description=Seed Pneuma desktop configs for existing users
# Pure file copies from /etc/skel — deliberately independent of the
# base's brew-setup so the Pneuma session is complete before the first
# login (pneuma-user-setup needs brew's stow and can't run pre-greeter).
After=local-fs.target
Before=display-manager.service pneuma-greeter-setup.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/pneuma-skel-seed
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
