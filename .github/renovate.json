{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 20,
  "recreateWhen": "always",
  "rebaseWhen": "auto",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned container images in Justfile variables",
      "managerFilePatterns": [
        "/^Justfile$/"
      ],
      "matchStrings": [
        "export\\s+\\w+\\s+:=\\s+env\\(\"[^\"]+\",\\s+\"(?<packageName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^\\s@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\"\\)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track Ghostty releases in build script",
      "managerFilePatterns": [
        "/^build\\/30-ghostty\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nGHOSTTY_VERSION=\"(?<currentValue>\\S+?)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track pinned tool versions in workflow env vars",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+\\w+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge safe low-risk updates (digest/pin only) when checks pass",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Keep the shared projectbluefin actions channel fresh",
      "matchPackageNames": [
        "projectbluefin/actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin",
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Ghostty bumps require matching Zig version \u2014 review before merging",
      "matchDepNames": [
        "ghostty-org/ghostty"
      ],
      "automerge": false
    },
    {
      "description": "Keep the bluefin-lts base digest fresh immediately",
      "matchDepNames": [
        "ghcr.io/projectbluefin/bluefin-lts"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "automerge": true,
      "schedule": [
        "at any time"
      ]
    }
  ]
}
